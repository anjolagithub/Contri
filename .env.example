# Chain: 10143 = Monad testnet (default), 31337 = local anvil
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# From `forge script script/Deploy.s.sol` output
NEXT_PUBLIC_FORWARDER=
NEXT_PUBLIC_CONTRI=
NEXT_PUBLIC_TOKEN=

# Server only. A fresh throwaway wallet funded with testnet MON. It pays gas for everyone.
# Never use a wallet that holds real funds.
RELAYER_PRIVATE_KEY=

# Set to "off" to disable the testnet demo members
DEMO_MEMBERS=on
